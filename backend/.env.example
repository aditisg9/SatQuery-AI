# ---- App mode ----
# DEMO_MODE=true runs the entire app with mocked/heuristic AI results.
# No GPU, no API key, and no internet access are required in this mode.
DEMO_MODE=true

# ---- Gemini (Google Generative AI) ----
# Only needed when DEMO_MODE=false. Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Database ----
# Default: local SQLite file, zero setup.
# For Postgres (docker-compose / Render), use:
# DATABASE_URL=postgresql+psycopg2://satquery:satquery@db:5432/satquery
DATABASE_URL=sqlite:///./satquery.db

# ---- CORS ----
FRONTEND_ORIGIN=http://localhost:3000
